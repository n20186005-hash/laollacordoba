---
import type { Lang } from '../i18n/utils';
import { cumbrecita, t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => t(s, lang);
const href = `/${lang}/la-cumbrecita/`;
---
<section class="bg-[color:var(--color-sun)] text-[color:var(--color-ink)] py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="max-w-2xl">
      <div class="text-xs uppercase tracking-[0.25em] opacity-70">{_(cumbrecita.teaser.kicker)}</div>
      <h2 class="font-display text-3xl md:text-4xl mt-3">{_(cumbrecita.teaser.title)}</h2>
      <p class="mt-3 text-[color:var(--color-ink)]/80 leading-relaxed">{_(cumbrecita.teaser.text)}</p>
    </div>
    <a href={href} class="shrink-0 inline-flex items-center gap-2 bg-[color:var(--color-ink)] text-[color:var(--color-cream)] rounded-full px-6 py-3 text-sm font-semibold hover:opacity-90 transition-opacity">
      {_(cumbrecita.teaser.link)} →
    </a>
  </div>
</section>
