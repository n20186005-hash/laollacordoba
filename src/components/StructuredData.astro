---
import type { Lang } from '../i18n/utils';
import { faq as faqT, t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const descMap: Record<Lang, string> = {
  zh: 'La Olla（拉昆布雷西塔）是阿根廷科尔多瓦省卡拉穆奇塔山谷的一处天然水潭，由瀑布长年冲刷岩石形成，深约 6 米，是知名的远足区与夏季戏水地。',
  en: 'La Olla in La Cumbrecita — a natural pool in the Calamuchita Valley of Córdoba Province, Argentina, carved by a waterfall into the rock to about 6 m deep; a popular hiking area and summer swim spot.',
  it: 'La Olla a La Cumbrecita — una pozza naturale nella valle di Calamuchita (provincia di Córdoba, Argentina), scavata da una cascata nella roccia fino a circa 6 m di profondità; una popolare zona di trekking e bagno estivo.',
  es: 'La Olla en La Cumbrecita — una poza natural del Valle de Calamuchita, en la provincia de Córdoba, Argentina, tallada por una cascada en la roca hasta unos 6 m de profundidad; un área de senderismo y balneario de verano muy visitada.',
};

const nameMap: Record<Lang, string> = {
  zh: 'La Olla（拉昆布雷西塔）天然水潭',
  en: 'La Olla (La Cumbrecita) — Natural pool',
  it: 'La Olla (La Cumbrecita) — Pozza naturale',
  es: 'La Olla (La Cumbrecita) — Poza natural',
};

const tourist = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'TouristAttraction',
  name: nameMap[lang], description: descMap[lang],
  image: new URL('/gallery/la-olla-1.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: 'La Cumbrecita', addressLocality: 'La Cumbrecita', addressRegion: 'Córdoba', postalCode: '', addressCountry: 'AR' },
  geo: { '@type': 'GeoCoordinates', latitude: -32.1236, longitude: -64.7667 },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.7', reviewCount: '19085' },
  openingHours: 'Mo-Su 00:00-24:00',
});

const faqData = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqT.items.map((item) => ({
    '@type': 'Question',
    name: t(item.q, lang),
    acceptedAnswer: { '@type': 'Answer', text: t(item.a, lang) },
  })),
});
---
<Fragment set:html={'<script type="application/ld+json">' + tourist + '</script><script type="application/ld+json">' + faqData + '</script>'} />
